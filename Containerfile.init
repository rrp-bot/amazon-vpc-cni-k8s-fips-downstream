ARG golang_image=registry.access.redhat.com/ubi9/go-toolset:9.8-1791479310
ARG base_image=registry.access.redhat.com/ubi9/ubi-minimal:9.8-1791765279

FROM ${golang_image} AS builder

USER root
WORKDIR /workspace/upstream
COPY upstream/ ./

ENV GO111MODULE=on \
    GOPROXY=direct \
    CGO_ENABLED=1 \
    GOFIPS140=certified \
    GOFLAGS=-buildvcs=false

ARG GO_BUILD_TAGS=strictfipsruntime,no_openssl
ARG VERSION=downstream

RUN make plugins && \
    curl -fsSL https://raw.githubusercontent.com/awslabs/amazon-eks-ami/main/log-collector-script/linux/eks-log-collector.sh \
      -o /workspace/upstream/aws-cni-support.sh && \
    chmod +x /workspace/upstream/aws-cni-support.sh && \
    mkdir -p /out && \
    go build -buildmode=pie -tags "${GO_BUILD_TAGS}" \
      -ldflags "-s -w -X pkg/version/info.Version=${VERSION} -X pkg/awsutils/awssession.version=${VERSION}" \
      -o /out/aws-vpc-cni-init ./cmd/aws-vpc-cni-init

FROM ${base_image}

ARG SOURCE_URL=https://github.com/aws/amazon-vpc-cni-k8s
ARG SOURCE_REVISION=unknown
ARG VERSION=downstream

LABEL org.opencontainers.image.title="Amazon VPC CNI init" \
      org.opencontainers.image.description="FIPS-enabled Amazon VPC CNI init container" \
      org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.version="${VERSION}"

RUN microdnf install -y ca-certificates iproute iptables openssl-libs util-linux-core && \
    microdnf clean all && \
    rm -rf /var/cache/yum

ENV GODEBUG=fips140=auto
WORKDIR /init

COPY --from=builder /workspace/upstream/core-plugins/ \
    /workspace/upstream/aws-cni-support.sh \
    /out/aws-vpc-cni-init \
    /init/

CMD ["/init/aws-vpc-cni-init"]
