ARG golang_image=registry.access.redhat.com/ubi9/go-toolset:9.8-1791479310
ARG base_image=registry.access.redhat.com/ubi9/ubi-minimal:9.8-1791765279

FROM ${golang_image} AS builder

USER root
WORKDIR /workspace/upstream
COPY upstream/ ./

ENV GO111MODULE=on \
    GOPROXY=direct \
    CGO_ENABLED=1 \
    GOFIPS140=certified \
    GOFLAGS=-buildvcs=false

ARG GO_BUILD_TAGS=strictfipsruntime,no_openssl
ARG VERSION=downstream

RUN mkdir -p /out && \
    go build -buildmode=pie -tags "${GO_BUILD_TAGS}" \
      -ldflags "-s -w -X pkg/version/info.Version=${VERSION}" \
      -o /out/cni-metrics-helper ./cmd/cni-metrics-helper

FROM ${base_image}

ARG SOURCE_URL=https://github.com/aws/amazon-vpc-cni-k8s
ARG SOURCE_REVISION=unknown
ARG VERSION=downstream

LABEL org.opencontainers.image.title="Amazon CNI metrics helper" \
      org.opencontainers.image.description="FIPS-enabled Amazon VPC CNI metrics helper" \
      org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.version="${VERSION}"

RUN microdnf install -y ca-certificates openssl-libs && \
    microdnf clean all && \
    rm -rf /var/cache/yum

ENV GODEBUG=fips140=auto
COPY upstream/misc/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/cni-metrics-helper /app/cni-metrics-helper

ENTRYPOINT ["/app/cni-metrics-helper", "--cloudwatch=false"]
